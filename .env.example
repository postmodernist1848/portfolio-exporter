DATABASE_URL="postgresql://postgres:postgres@db:5432/portfolio_exporter"
# Optional direct PostgreSQL connection for schema commands; runtime uses DATABASE_URL.
DIRECT_URL=""
# Docker/local timer; automatically disabled on Vercel. Set false for external cron.
SCHEDULER_ENABLED="true"

# Single-user HTTP Basic Auth. Use ASCII credentials; keep them server-only.
PORTFOLIO_AUTH_USERNAME="portfolio"
PORTFOLIO_AUTH_PASSWORD=""

# Crypto
BTC_ADDRESSES=""
EVM_ADDRESSES=""
HYPERLIQUID_ADDRESSES=""
SOL_ADDRESSES=""
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
ALCHEMY_API_KEY=""

# BCS API
BCS_REFRESH_TOKEN=""
BCS_CLIENT_ID="trade-api-read"
BCS_ALLOW_SELF_SIGNED_TLS="false"

# T-Invest API
TINVEST_API_TOKEN=""
TINVEST_ALLOW_SELF_SIGNED_TLS="true"

# OKX asset valuation API (read-only API key)
OKX_API_BASE_URL="https://www.okx.com"
OKX_API_KEY=""
OKX_SECRET_KEY=""
OKX_API_PASSPHRASE=""
